# AI 
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# auto   = keys starting with "AQ." use Vertex AI Express, all others use Google AI Studio
# studio = force Google AI Studio   |   vertex = force Vertex AI Express
GEMINI_BACKEND=auto

# API version: v1beta | v1
GEMINI_API_VERSION=v1beta

# Seconds to wait for one Gemini call before using the demo story
GEMINI_TIMEOUT_SECONDS=45
GEMINI_TEMPERATURE=0.6

# Limits
# Max stories one user can generate per hour (protects your free quota). 0 = unlimited.
GENERATE_LIMIT_PER_HOUR=10

# Database 
# Leave empty to use SQLite (backend/storylingo.db). For Supabase / PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Web 
# Comma-separated exact frontend origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Google Identity Services: Web application OAuth Client ID (public identifier)
GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:5500

# SMTP password recovery: never put these values in frontend code
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
